   0  $accept : prog $end

   1  prog : ID ASIG expresion

   2  expresion : ID
   3            | CTE

state 0
	$accept : . prog $end  (0)

	ID  shift 1
	.  error

	prog  goto 2


state 1
	prog : ID . ASIG expresion  (1)

	ASIG  shift 3
	.  error


state 2
	$accept : prog . $end  (0)

	$end  accept


state 3
	prog : ID ASIG . expresion  (1)

	ID  shift 4
	CTE  shift 5
	.  error

	expresion  goto 6


state 4
	expresion : ID .  (2)

	.  reduce 2


state 5
	expresion : CTE .  (3)

	.  reduce 3


state 6
	prog : ID ASIG expresion .  (1)

	.  reduce 1


5 terminals, 3 nonterminals
4 grammar rules, 7 states
