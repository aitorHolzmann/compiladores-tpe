  28  lista_parametros_formales :
  29                            | parametro_formal
  30                            | lista_parametros_formales ',' parametro_formal

  31  parametro_formal : tipo IDENTIFICADOR

  32  declaracion_clase : CLASS IDENTIFICADOR importacion_opcional BEGIN herencia_opcional miembros_clase END ';'
  33                    | CLASS IDENTIFICADOR importacion_opcional BEGIN herencia_opcional miembros_clase END

  34  importacion_opcional :
  35                       | IMPORT FROM lista_identificadores

  36  herencia_opcional :
  37                    | EXTENDS lista_identificadores ';'

  38  miembros_clase :
  39                 | miembros_clase miembro_clase

  40  miembro_clase : atributo_clase
  41                | metodo_clase

  42  atributo_clase : tipo lista_identificadores exportacion_opcional ';'

  43  metodo_clase : tipo IDENTIFICADOR '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END exportacion_opcional ';'
  44               | AUTO IDENTIFICADOR '(' lista_parametros_formales ')' BEGIN sentencias_ejecutables END exportacion_opcional ';'

  45  exportacion_opcional :
  46                       | EXPORT TO lista_identificadores

  47  declaracion_objeto : IDENTIFICADOR lista_identificadores ';'
  48                     | IDENTIFICADOR lista_identificadores

  49  declaracion_comptime : COMPTIME tipo lista_identificadores ';'
  50                       | COMPTIME tipo lista_identificadores

  51  sentencias_ejecutables :
  52                         | sentencias_ejecutables sentencia_ejecutable

  53  sentencia_ejecutable : asignacion ';'
  54                       | expresion ';'
  55                       | sentencia_if
  56                       | sentencia_repeat_until
  57                       | sentencia_pout ';'
  58                       | sentencia_ret ';'
  59                       | error ';'

  60  asignacion : IDENTIFICADOR ASIGNAR expresion
  61             | acceso_posicional ASIGNAR expresion

  62  acceso_posicional : IDENTIFICADOR '[' CONSTANTE ']'
  63                    | IDENTIFICADOR '[' IDENTIFICADOR ']'

  64  expresion : termino
  65            | expresion '+' termino
  66            | expresion '-' termino

  67  termino : factor
  68          | termino '*' factor
  69          | termino '/' factor

  70  factor : IDENTIFICADOR
  71         | CONSTANTE
  72         | IDENTIFICADOR '(' ')'
  73         | IDENTIFICADOR '(' lista_expresiones ')'
  74         | invocacion_metodo
  75         | unica
  76         | numero_negativo
  77         | conversion_tos
  78         | acceso_posicional

  79  invocacion_metodo : IDENTIFICADOR '.' IDENTIFICADOR '(' ')'
  80                    | IDENTIFICADOR '.' IDENTIFICADOR '(' lista_expresiones ')'

  81  lista_expresiones : expresion
