  27                        | encabezado_auto_funcion BEGIN sentencias_ejecutables END ';'

  28  $$4 :

  29  declaracion_funciones : AUTO FUNCTION error $$4 '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END ';'
  30                        | encabezado_auto_funcion BEGIN sentencias_ejecutables END

  31  encabezado_auto_funcion : AUTO FUNCTION IDENTIFICADOR '(' lista_parametros_formales ')'

  32  lista_parametros_formales :
  33                            | parametro_formal
  34                            | lista_parametros_formales ',' parametro_formal

  35  parametro_formal : tipo IDENTIFICADOR
  36                   | tipo error
  37                   | error IDENTIFICADOR

  38  declaracion_clase : CLASS IDENTIFICADOR importacion_opcional BEGIN herencia_opcional miembros_clase END ';'
  39                    | CLASS IDENTIFICADOR importacion_opcional BEGIN herencia_opcional miembros_clase END

  40  importacion_opcional :
  41                       | IMPORT FROM lista_identificadores
  42                       | IMPORT lista_identificadores

  43  herencia_opcional :
  44                    | EXTENDS lista_identificadores ';'
  45                    | EXTENDS ';'

  46  miembros_clase :
  47                 | miembros_clase miembro_clase

  48  miembro_clase : atributo_clase
  49                | metodo_clase

  50  atributo_clase : tipo lista_identificadores exportacion_opcional ';'

  51  metodo_clase : tipo IDENTIFICADOR '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END exportacion_opcional ';'
  52               | AUTO IDENTIFICADOR '(' lista_parametros_formales ')' BEGIN sentencias_ejecutables END exportacion_opcional ';'

  53  exportacion_opcional :
  54                       | EXPORT TO lista_identificadores
  55                       | EXPORT lista_identificadores

  56  declaracion_objeto : IDENTIFICADOR lista_identificadores ';'
  57                     | IDENTIFICADOR lista_identificadores

  58  declaracion_comptime : COMPTIME tipo lista_identificadores ';'
  59                       | COMPTIME tipo lista_identificadores
  60                       | COMPTIME lista_identificadores ';'
  61                       | COMPTIME lista_identificadores

  62  sentencias_ejecutables :
  63                         | sentencias_ejecutables sentencia_ejecutable

  64  sentencia_ejecutable : asignacion ';'
  65                       | expresion ';'
  66                       | sentencia_if
  67                       | sentencia_repeat_until
  68                       | sentencia_pout ';'
  69                       | sentencia_ret ';'
  70                       | error ';'

  71  asignacion : IDENTIFICADOR ASIGNAR expresion
  72             | acceso_posicional ASIGNAR expresion

  73  acceso_posicional : IDENTIFICADOR '[' CONSTANTE ']'
  74                    | IDENTIFICADOR '[' IDENTIFICADOR ']'

  75  expresion : termino
  76            | expresion '+' termino
  77            | expresion '-' termino
  78            | expresion '+' error
  79            | expresion '-' error
  80            | '+' termino

  81  termino : factor
  82          | termino '*' factor
  83          | termino '/' factor
  84          | termino '*' error
  85          | termino '/' error
  86          | '*' factor
  87          | '/' factor
  88          | termino IDENTIFICADOR
  89          | termino CONSTANTE

  90  factor : IDENTIFICADOR
  91         | CONSTANTE
  92         | IDENTIFICADOR '(' ')'
  93         | IDENTIFICADOR '(' lista_expresiones ')'
  94         | invocacion_metodo
  95         | unica
  96         | numero_negativo
  97         | conversion_tos
  98         | acceso_posicional

  99  invocacion_metodo : IDENTIFICADOR '.' IDENTIFICADOR '(' ')'
 100                    | IDENTIFICADOR '.' IDENTIFICADOR '(' lista_expresiones ')'

 101  lista_expresiones : expresion
 102                    | lista_expresiones ',' expresion

 103  unica : IDENTIFICADOR '=' '(' expresion ')'
 104        | IDENTIFICADOR ASIGNAR '(' expresion ')'

 105  numero_negativo : '-' CONSTANTE

 106  conversion_tos : TOS '(' expresion ')'

 107  sentencia_if : IF '(' condicion ')' bloque resto_if
 108               | IF condicion ')' bloque resto_if
 109               | IF error bloque resto_if

 110  resto_if : END_IF ';'
 111           | ELSE bloque END_IF ';'
 112           | ';'
 113           | ELSE bloque ';'

 114  condicion : expresion comparador expresion

 115  comparador : MAYORIGUAL
 116             | MENORIGUAL
 117             | IGUALIGUAL
 118             | DISTINTO
 119             | '>'
 120             | '<'

 121  bloque : BEGIN sentencias_ejecutables END
 122         | sentencia_ejecutable
 123         | BEGIN sentencias_ejecutables

 124  sentencia_repeat_until : REPEAT bloque UNTIL condicion_iteracion ';'
 125                         | REPEAT UNTIL condicion_iteracion ';'
 126                         | REPEAT bloque '(' condicion ')' ';'
 127                         | REPEAT '(' condicion ')' ';'
 128                         | REPEAT bloque '(' condicion ';'
 129                         | REPEAT '(' condicion ';'

 130  condicion_iteracion : '(' condicion ')'
 131                      | condicion ')'
 132                      | '(' condicion
 133                      | condicion

 134  sentencia_pout : POUT '(' CADENA ')'
 135                 | POUT '(' expresion ')'
 136                 | POUT '(' ')'

 137  sentencia_ret : RET '(' expresion ')'

