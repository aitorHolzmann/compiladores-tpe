  97         | BEGIN sentencias_ejecutables

  98  sentencia_repeat_until : REPEAT bloque UNTIL '(' condicion ')' ';'

  99  sentencia_pout : POUT '(' CADENA ')'
 100                 | POUT '(' expresion ')'

 101  sentencia_ret : RET '(' expresion ')'

