   0  $accept : programa $end

   1  programa : IDENTIFICADOR sentencias_declarativas BEGIN sentencias_ejecutables END

   2  sentencias_declarativas :
   3                          | sentencias_declarativas sentencia_declarativa

   4  sentencia_declarativa : declaracion_variables
   5                        | declaracion_funcion
   6                        | declaracion_clase
   7                        | declaracion_objeto
   8                        | declaracion_comptime

   9  tipo : SHORTINT
  10       | SINGLEF

  11  declaracion_variables : tipo lista_identificadores ';'

  12  lista_identificadores : IDENTIFICADOR
  13                        | lista_identificadores ',' IDENTIFICADOR

  14  declaracion_comptime : COMPTIME tipo lista_identificadores ';'

  15  declaracion_funcion : tipo FUNCTION IDENTIFICADOR '(' parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END ';'
  16                      | AUTO FUNCTION IDENTIFICADOR '(' parametros_formales ')' BEGIN sentencias_ejecutables END ';'

  17  parametros_formales : parametro
  18                      | parametros_formales ',' parametro

  19  parametro : tipo IDENTIFICADOR

  20  declaracion_clase : CLASS IDENTIFICADOR clausula_import BEGIN miembros_clase END ';'

  21  clausula_import :
  22                  | IMPORT FROM lista_identificadores

  23  miembros_clase :
  24                 | miembros_clase miembro_clase

  25  miembro_clase : tipo IDENTIFICADOR clausula_export ';'
  26                | tipo IDENTIFICADOR '(' parametros_formales ')' BEGIN sentencias_ejecutables END ';' clausula_export_opt
  27                | EXTENDS lista_identificadores ';'

  28  clausula_export :
  29                  | EXPORT TO lista_identificadores

  30  clausula_export_opt :
  31                      | EXPORT TO lista_identificadores ';'

  32  declaracion_objeto : IDENTIFICADOR lista_identificadores ';'

  33  sentencias_ejecutables :
  34                         | sentencias_ejecutables sentencia_ejecutable

  35  sentencia_ejecutable : asignacion ';'
  36                       | invocacion ';'
  37                       | sentencia_if
  38                       | sentencia_pout ';'
  39                       | sentencia_ret ';'
  40                       | sentencia_repeat_until

  41  bloque : BEGIN sentencias_ejecutables END

  42  bloque_o_sentencia : sentencia_ejecutable
  43                     | bloque

  44  asignacion : IDENTIFICADOR ASIGNAR expresion
  45             | acceso_atributo ASIGNAR expresion
  46             | acceso_posicional ASIGNAR expresion

  47  acceso_atributo : IDENTIFICADOR '.' IDENTIFICADOR

  48  acceso_posicional : IDENTIFICADOR '[' expresion ']'

  49  invocacion : IDENTIFICADOR '(' lista_parametros_reales ')'
  50             | IDENTIFICADOR '.' IDENTIFICADOR '(' lista_parametros_reales ')'

  51  lista_parametros_reales : expresion
  52                          | lista_parametros_reales ',' expresion

  53  sentencia_if : IF '(' condicion ')' bloque_o_sentencia ELSE bloque_o_sentencia END_IF ';'
  54               | IF '(' condicion ')' bloque_o_sentencia END_IF ';'

  55  condicion : expresion comparador expresion

  56  comparador : MAYORIGUAL
  57             | MENORIGUAL
  58             | IGUALIGUAL
  59             | DISTINTO
  60             | '>'
  61             | '<'

  62  sentencia_pout : POUT '(' expresion ')'
  63                 | POUT '(' CADENA ')'

  64  sentencia_ret : RET '(' expresion ')'

  65  sentencia_repeat_until : REPEAT bloque_o_sentencia UNTIL '(' condicion ')' ';'

  66  expresion : termino
  67            | expresion '+' termino
  68            | expresion '-' termino

  69  termino : factor
  70          | termino '*' factor
  71          | termino '/' factor

  72  factor : IDENTIFICADOR
  73         | CONSTANTE
  74         | invocacion
  75         | acceso_atributo
  76         | acceso_posicional
  77         | TOS '(' expresion ')'
  78         | IDENTIFICADOR '=' '(' expresion ')'

