  83  unica : IDENTIFICADOR '=' '(' expresion ')'

  84  numero_negativo : '-' CONSTANTE

  85  conversion_tos : TOS '(' expresion ')'

  86  sentencia_if : IF '(' condicion ')' bloque ELSE bloque END_IF ';'
  87               | IF '(' condicion ')' bloque END_IF ';'

  88  condicion : expresion comparador expresion

  89  comparador : MAYORIGUAL
  90             | MENORIGUAL
  91             | IGUALIGUAL
  92             | DISTINTO
  93             | '>'
  94             | '<'

  95  bloque : BEGIN sentencias_ejecutables END
