   7  sentencias_declarativas :
   8                          | sentencias_declarativas sentencia_declarativa

   9  sentencia_declarativa : declaracion_variables
  10                        | declaracion_funciones
  11                        | declaracion_clase
  12                        | declaracion_objeto
  13                        | declaracion_comptime

  14  declaracion_variables : tipo lista_variables ';'
  15                        | tipo error ';'

  16  lista_variables : IDENTIFICADOR
  17                  | lista_variables ',' IDENTIFICADOR
  18                  | lista_variables IDENTIFICADOR

  19  lista_identificadores : IDENTIFICADOR
  20                        | lista_identificadores ',' IDENTIFICADOR

  21  tipo : SHORTINT
  22       | SINGLEF

  23  declaracion_funciones : tipo FUNCTION IDENTIFICADOR '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END ';'

  24  $$3 :

  25  declaracion_funciones : tipo FUNCTION error $$3 '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END ';'
