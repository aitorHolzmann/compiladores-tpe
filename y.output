   0  $accept : programa $end

   1  programa : IDENTIFICADOR sentencias_declarativas BEGIN sentencias_ejecutables END

   2  sentencias_declarativas :
   3                          | sentencias_declarativas sentencia_declarativa

   4  sentencia_declarativa : declaracion_variables
   5                        | declaracion_funciones
   6                        | declaracion_clase
   7                        | declaracion_objeto
   8                        | declaracion_comptime

   9  declaracion_variables : tipo lista_identificadores ';'

  10  lista_identificadores : IDENTIFICADOR
  11                        | lista_identificadores ',' IDENTIFICADOR

  12  tipo : SHORTINT
  13       | SINGLEF

  14  declaracion_funciones : tipo FUNCTION IDENTIFICADOR '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END ';'
  15                        | AUTO FUNCTION IDENTIFICADOR '(' lista_parametros_formales ')' BEGIN sentencias_ejecutables END ';'

  16  lista_parametros_formales :
  17                            | parametro_formal
  18                            | lista_parametros_formales ',' parametro_formal

  19  parametro_formal : tipo IDENTIFICADOR

  20  declaracion_clase : CLASS IDENTIFICADOR importacion_opcional BEGIN herencia_opcional miembros_clase END ';'

  21  importacion_opcional :
  22                       | IMPORT FROM lista_identificadores

  23  herencia_opcional :
  24                    | EXTENDS lista_identificadores ';'

  25  miembros_clase :
  26                 | miembros_clase miembro_clase

  27  miembro_clase : atributo_clase
  28                | metodo_clase

  29  atributo_clase : tipo lista_identificadores exportacion_opcional ';'

  30  metodo_clase : tipo IDENTIFICADOR '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END exportacion_opcional ';'
  31               | AUTO IDENTIFICADOR '(' lista_parametros_formales ')' BEGIN sentencias_ejecutables END exportacion_opcional ';'
  32               | tipo FUNCTION IDENTIFICADOR '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END exportacion_opcional ';'
  33               | AUTO FUNCTION IDENTIFICADOR '(' lista_parametros_formales ')' BEGIN sentencias_ejecutables END exportacion_opcional ';'

  34  exportacion_opcional :
  35                       | EXPORT TO lista_identificadores

  36  declaracion_objeto : IDENTIFICADOR lista_identificadores ';'

  37  declaracion_comptime : COMPTIME tipo lista_identificadores ';'

  38  sentencias_ejecutables :
  39                         | sentencias_ejecutables sentencia_ejecutable

  40  sentencia_ejecutable : asignacion ';'
  41                       | expresion ';'
  42                       | sentencia_if
  43                       | sentencia_repeat_until
  44                       | sentencia_pout ';'
  45                       | sentencia_ret ';'

  46  asignacion : IDENTIFICADOR ASIGNAR expresion
  47             | acceso_posicional ASIGNAR expresion

  48  acceso_posicional : IDENTIFICADOR '[' CONSTANTE ']'
  49                    | IDENTIFICADOR '[' IDENTIFICADOR ']'

  50  expresion : termino
  51            | expresion '+' termino
  52            | expresion '-' termino

  53  termino : factor
  54          | termino '*' factor
  55          | termino '/' factor

  56  factor : IDENTIFICADOR
  57         | CONSTANTE
  58         | IDENTIFICADOR '(' ')'
  59         | IDENTIFICADOR '(' lista_expresiones ')'
  60         | invocacion_metodo
  61         | unica
  62         | numero_negativo
  63         | conversion_tos
  64         | acceso_posicional

  65  invocacion_metodo : IDENTIFICADOR '.' IDENTIFICADOR '(' ')'
  66                    | IDENTIFICADOR '.' IDENTIFICADOR '(' lista_expresiones ')'

  67  lista_expresiones : expresion
  68                    | lista_expresiones ',' expresion

  69  unica : IDENTIFICADOR '=' '(' expresion ')'

  70  numero_negativo : '-' CONSTANTE

  71  conversion_tos : TOS '(' expresion ')'

  72  sentencia_if : IF '(' condicion ')' bloque ELSE bloque END_IF ';'
  73               | IF '(' condicion ')' bloque END_IF ';'

  74  condicion : expresion comparador expresion

  75  comparador : MAYORIGUAL
  76             | MENORIGUAL
  77             | IGUALIGUAL
  78             | DISTINTO
  79             | '>'
  80             | '<'

  81  bloque : BEGIN sentencias_ejecutables END
  82         | sentencia_ejecutable

  83  sentencia_repeat_until : REPEAT bloque UNTIL '(' condicion ')' ';'

  84  sentencia_pout : POUT '(' CADENA ')'
  85                 | POUT '(' expresion ')'

  86  sentencia_ret : RET '(' expresion ')'

