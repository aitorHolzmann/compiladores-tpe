   0  $accept : programa $end

   1  nombre_programa : IDENTIFICADOR

   2  programa : nombre_programa sentencias_declarativas BEGIN sentencias_ejecutables END

   3  $$1 :

   4  programa : error $$1 sentencias_declarativas BEGIN sentencias_ejecutables END

   5  $$2 :

   6  programa : nombre_programa sentencias_declarativas error $$2 sentencias_ejecutables END
   7           | nombre_programa sentencias_declarativas BEGIN sentencias_ejecutables

   8  sentencias_declarativas :
   9                          | sentencias_declarativas sentencia_declarativa

  10  sentencia_declarativa : declaracion_variables
  11                        | declaracion_funciones
  12                        | declaracion_clase
  13                        | declaracion_objeto
  14                        | declaracion_comptime

  15  declaracion_variables : tipo lista_variables ';'
  16                        | tipo error ';'

  17  lista_variables : IDENTIFICADOR
  18                  | lista_variables ',' IDENTIFICADOR
  19                  | lista_variables IDENTIFICADOR

  20  lista_identificadores : IDENTIFICADOR
  21                        | lista_identificadores ',' IDENTIFICADOR

  22  tipo : SHORTINT
  23       | SINGLEF

  24  encabezado_funcion : tipo FUNCTION IDENTIFICADOR

  25  inicio_auto_funcion : AUTO FUNCTION IDENTIFICADOR

  26  encabezado_auto_funcion : inicio_auto_funcion '(' lista_parametros_formales ')'

  27  declaracion_funciones : encabezado_funcion '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END ';'

  28  $$3 :

  29  declaracion_funciones : tipo FUNCTION error $$3 '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END ';'
  30                        | encabezado_funcion '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END
  31                        | encabezado_auto_funcion BEGIN sentencias_ejecutables END ';'

  32  $$4 :

  33  declaracion_funciones : AUTO FUNCTION error $$4 '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END ';'
  34                        | encabezado_auto_funcion BEGIN sentencias_ejecutables END

  35  lista_parametros_formales :
  36                            | parametro_formal
  37                            | lista_parametros_formales ',' parametro_formal

  38  parametro_formal : tipo IDENTIFICADOR
  39                   | IDENTIFICADOR IDENTIFICADOR
  40                   | tipo error
  41                   | error IDENTIFICADOR

  42  encabezado_clase : CLASS IDENTIFICADOR

  43  declaracion_clase : encabezado_clase importacion_opcional BEGIN herencia_opcional miembros_clase END ';'
  44                    | encabezado_clase importacion_opcional BEGIN herencia_opcional miembros_clase END

  45  importacion_opcional :
  46                       | IMPORT FROM lista_identificadores
  47                       | IMPORT lista_identificadores

  48  herencia_opcional :
  49                    | EXTENDS lista_identificadores ';'
  50                    | EXTENDS ';'

  51  miembros_clase :
  52                 | miembros_clase miembro_clase

  53  miembro_clase : atributo_clase
  54                | metodo_clase

  55  atributo_clase : tipo lista_identificadores exportacion_opcional ';'

  56  metodo_clase : encabezado_metodo '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END exportacion_opcional ';'
  57               | encabezado_metodo_auto '(' lista_parametros_formales ')' BEGIN sentencias_ejecutables END exportacion_opcional ';'

  58  encabezado_metodo : tipo IDENTIFICADOR

  59  encabezado_metodo_auto : AUTO IDENTIFICADOR

  60  exportacion_opcional :
  61                       | EXPORT TO lista_identificadores
  62                       | EXPORT lista_identificadores

  63  declaracion_objeto : IDENTIFICADOR lista_identificadores ';'
  64                     | IDENTIFICADOR lista_identificadores

  65  declaracion_comptime : COMPTIME tipo lista_identificadores ';'
  66                       | COMPTIME tipo lista_identificadores
  67                       | COMPTIME lista_identificadores ';'
  68                       | COMPTIME lista_identificadores

  69  sentencias_ejecutables :
  70                         | sentencias_ejecutables sentencia_ejecutable

  71  sentencia_ejecutable : asignacion ';'
  72                       | expresion ';'
  73                       | sentencia_if
  74                       | sentencia_repeat_until
  75                       | sentencia_pout ';'
  76                       | sentencia_ret ';'
  77                       | error ';'

  78  asignacion : IDENTIFICADOR ASIGNAR expresion
  79             | acceso_posicional ASIGNAR expresion

  80  acceso_posicional : IDENTIFICADOR '[' CTE_SHORTINT ']'
  81                    | IDENTIFICADOR '[' IDENTIFICADOR ']'
  82                    | IDENTIFICADOR '[' CTE_SINGLEF ']'

  83  expresion : termino
  84            | expresion '+' termino
  85            | expresion '-' termino
  86            | expresion '+' error
  87            | expresion '-' error
  88            | '+' termino

  89  termino : factor
  90          | termino '*' factor
  91          | termino '/' factor
  92          | termino '*' error
  93          | termino '/' error
  94          | '*' factor
  95          | '/' factor
  96          | termino IDENTIFICADOR
  97          | termino CTE_SHORTINT
  98          | termino CTE_SINGLEF

  99  factor : IDENTIFICADOR
 100         | CTE_SHORTINT
 101         | CTE_SINGLEF
 102         | IDENTIFICADOR '(' ')'
 103         | IDENTIFICADOR '(' lista_expresiones ')'
 104         | invocacion_metodo
 105         | unica
 106         | numero_negativo
 107         | conversion_tos
 108         | acceso_posicional

 109  invocacion_metodo : IDENTIFICADOR '.' IDENTIFICADOR '(' ')'
 110                    | IDENTIFICADOR '.' IDENTIFICADOR '(' lista_expresiones ')'

 111  lista_expresiones : expresion
 112                    | lista_expresiones ',' expresion

 113  unica : IDENTIFICADOR '=' '(' expresion ')'
 114        | IDENTIFICADOR ASIGNAR '(' expresion ')'

 115  numero_negativo : '-' CTE_SHORTINT
 116                  | '-' CTE_SINGLEF

 117  conversion_tos : TOS '(' expresion ')'

 118  encabezado_if : IF '(' condicion ')'

 119  sentencia_if : encabezado_if bloque resto_if
 120               | IF condicion ')' bloque resto_if
 121               | IF error bloque resto_if

 122  inicio_else : ELSE

 123  resto_if : END_IF ';'
 124           | inicio_else bloque END_IF ';'
 125           | ';'
 126           | inicio_else bloque ';'

 127  condicion : expresion comparador expresion

 128  comparador : MAYORIGUAL
 129             | MENORIGUAL
 130             | IGUALIGUAL
 131             | DISTINTO
 132             | '>'
 133             | '<'

 134  bloque : BEGIN sentencias_ejecutables END
 135         | sentencia_ejecutable
 136         | BEGIN sentencias_ejecutables

 137  inicio_repeat : REPEAT

 138  sentencia_repeat_until : inicio_repeat bloque UNTIL condicion_iteracion ';'
 139                         | inicio_repeat UNTIL condicion_iteracion ';'
 140                         | inicio_repeat bloque '(' condicion ')' ';'
 141                         | inicio_repeat '(' condicion ')' ';'
 142                         | inicio_repeat bloque '(' condicion ';'
 143                         | inicio_repeat '(' condicion ';'

 144  condicion_iteracion : '(' condicion ')'
 145                      | condicion ')'
 146                      | '(' condicion
 147                      | condicion

 148  sentencia_pout : POUT '(' CADENA ')'
 149                 | POUT '(' expresion ')'
 150                 | POUT '(' ')'

 151  sentencia_ret : RET '(' expresion ')'

