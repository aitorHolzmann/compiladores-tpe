   4  programa : error $$1 sentencias_declarativas BEGIN sentencias_ejecutables END

   5  $$2 :

   6  programa : nombre_programa sentencias_declarativas error $$2 sentencias_ejecutables END
   7           | nombre_programa sentencias_declarativas BEGIN sentencias_ejecutables

   8  sentencias_declarativas :
   9                          | sentencias_declarativas sentencia_declarativa

  10  sentencia_declarativa : declaracion_variables
  11                        | declaracion_funciones
  12                        | declaracion_clase
  13                        | declaracion_objeto
  14                        | declaracion_comptime

  15  declaracion_variables : tipo lista_variables ';'
  16                        | tipo error ';'

  17  lista_variables : IDENTIFICADOR
  18                  | lista_variables ',' IDENTIFICADOR
  19                  | lista_variables IDENTIFICADOR

  20  lista_identificadores : IDENTIFICADOR
  21                        | lista_identificadores ',' IDENTIFICADOR

  22  tipo : SHORTINT
  23       | SINGLEF

  24  encabezado_funcion : tipo FUNCTION IDENTIFICADOR

  25  inicio_auto_funcion : AUTO FUNCTION IDENTIFICADOR

  26  encabezado_auto_funcion : inicio_auto_funcion '(' lista_parametros_formales ')'

  27  declaracion_funciones : encabezado_funcion '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END ';'

  28  $$3 :

  29  declaracion_funciones : tipo FUNCTION error $$3 '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END ';'
  30                        | encabezado_funcion '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END
  31                        | encabezado_auto_funcion BEGIN sentencias_ejecutables END ';'

  32  $$4 :

  33  declaracion_funciones : AUTO FUNCTION error $$4 '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END ';'
  34                        | encabezado_auto_funcion BEGIN sentencias_ejecutables END

  35  lista_parametros_formales :
  36                            | parametro_formal
  37                            | lista_parametros_formales ',' parametro_formal

  38  parametro_formal : tipo IDENTIFICADOR
  39                   | tipo error
  40                   | error IDENTIFICADOR

  41  encabezado_clase : CLASS IDENTIFICADOR

  42  declaracion_clase : encabezado_clase importacion_opcional BEGIN herencia_opcional miembros_clase END ';'
  43                    | encabezado_clase importacion_opcional BEGIN herencia_opcional miembros_clase END

  44  importacion_opcional :
  45                       | IMPORT FROM lista_identificadores
  46                       | IMPORT lista_identificadores

  47  herencia_opcional :
  48                    | EXTENDS lista_identificadores ';'
  49                    | EXTENDS ';'

  50  miembros_clase :
  51                 | miembros_clase miembro_clase

  52  miembro_clase : atributo_clase
  53                | metodo_clase

  54  atributo_clase : tipo lista_identificadores exportacion_opcional ';'

  55  metodo_clase : encabezado_metodo '(' lista_parametros_formales ')' sentencias_declarativas BEGIN sentencias_ejecutables END exportacion_opcional ';'
  56               | encabezado_metodo_auto '(' lista_parametros_formales ')' BEGIN sentencias_ejecutables END exportacion_opcional ';'

  57  encabezado_metodo : tipo IDENTIFICADOR

  58  encabezado_metodo_auto : AUTO IDENTIFICADOR

  59  exportacion_opcional :
  60                       | EXPORT TO lista_identificadores
  61                       | EXPORT lista_identificadores

  62  declaracion_objeto : IDENTIFICADOR lista_identificadores ';'
  63                     | IDENTIFICADOR lista_identificadores

  64  declaracion_comptime : COMPTIME tipo lista_identificadores ';'
  65                       | COMPTIME tipo lista_identificadores
  66                       | COMPTIME lista_identificadores ';'
  67                       | COMPTIME lista_identificadores

  68  sentencias_ejecutables :
  69                         | sentencias_ejecutables sentencia_ejecutable

  70  sentencia_ejecutable : asignacion ';'
  71                       | expresion ';'
  72                       | sentencia_if
  73                       | sentencia_repeat_until
  74                       | sentencia_pout ';'
  75                       | sentencia_ret ';'
  76                       | error ';'

  77  asignacion : IDENTIFICADOR ASIGNAR expresion
  78             | acceso_posicional ASIGNAR expresion

  79  acceso_posicional : IDENTIFICADOR '[' CTE_SHORTINT ']'
  80                    | IDENTIFICADOR '[' IDENTIFICADOR ']'
  81                    | IDENTIFICADOR '[' CTE_SINGLEF ']'

  82  expresion : termino
  83            | expresion '+' termino
  84            | expresion '-' termino
  85            | expresion '+' error
  86            | expresion '-' error
  87            | '+' termino

  88  termino : factor
  89          | termino '*' factor
  90          | termino '/' factor
  91          | termino '*' error
  92          | termino '/' error
  93          | '*' factor
  94          | '/' factor
  95          | termino IDENTIFICADOR
  96          | termino CTE_SHORTINT
  97          | termino CTE_SINGLEF

  98  factor : IDENTIFICADOR
  99         | CTE_SHORTINT
 100         | CTE_SINGLEF
 101         | IDENTIFICADOR '(' ')'
 102         | IDENTIFICADOR '(' lista_expresiones ')'
 103         | invocacion_metodo
 104         | unica
 105         | numero_negativo
 106         | conversion_tos
 107         | acceso_posicional

 108  invocacion_metodo : IDENTIFICADOR '.' IDENTIFICADOR '(' ')'
 109                    | IDENTIFICADOR '.' IDENTIFICADOR '(' lista_expresiones ')'

 110  lista_expresiones : expresion
 111                    | lista_expresiones ',' expresion

 112  unica : IDENTIFICADOR '=' '(' expresion ')'
 113        | IDENTIFICADOR ASIGNAR '(' expresion ')'

 114  numero_negativo : '-' CTE_SHORTINT
 115                  | '-' CTE_SINGLEF

 116  conversion_tos : TOS '(' expresion ')'

 117  sentencia_if : IF '(' condicion ')' bloque resto_if
 118               | IF condicion ')' bloque resto_if
 119               | IF error bloque resto_if

 120  resto_if : END_IF ';'
 121           | ELSE bloque END_IF ';'
 122           | ';'
 123           | ELSE bloque ';'

 124  condicion : expresion comparador expresion

 125  comparador : MAYORIGUAL
 126             | MENORIGUAL
 127             | IGUALIGUAL
 128             | DISTINTO
 129             | '>'
 130             | '<'

 131  bloque : BEGIN sentencias_ejecutables END
 132         | sentencia_ejecutable
 133         | BEGIN sentencias_ejecutables

 134  sentencia_repeat_until : REPEAT bloque UNTIL condicion_iteracion ';'
 135                         | REPEAT UNTIL condicion_iteracion ';'
 136                         | REPEAT bloque '(' condicion ')' ';'
 137                         | REPEAT '(' condicion ')' ';'
 138                         | REPEAT bloque '(' condicion ';'
 139                         | REPEAT '(' condicion ';'

 140  condicion_iteracion : '(' condicion ')'
 141                      | condicion ')'
 142                      | '(' condicion
 143                      | condicion

 144  sentencia_pout : POUT '(' CADENA ')'
 145                 | POUT '(' expresion ')'
 146                 | POUT '(' ')'

 147  sentencia_ret : RET '(' expresion ')'

